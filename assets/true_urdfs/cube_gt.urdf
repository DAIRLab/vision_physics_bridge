<!-- Verified inertial properties by assuming the mesh represents an infinitely
thin, uniformly dense, hollow object.  Done via cnets-data-generation's
test_mesh_inertia.py script, which generated the following, assuming a mass
value of 0.37 kg:

    Object:  cube
    Center of mass:  [-3.21775074e-17 -3.37247656e-18 -4.38630824e-19]
    Inertia tensor about center of mass:
        [[ 1.12851848e-03 -8.07990022e-21 -7.42047184e-20]
        [-8.07990022e-21  1.12851848e-03 -1.13323744e-21]
        [-7.42047184e-20 -1.13323744e-21  1.12851848e-03]]

The friction coefficient was selected based on measurements taken during the
2020 ContactNets project which introduced the cube as a physical system.
-->

<?xml version="1.0"?>
<robot name="object" xmlns:drake="https://drake.mit.edu/">
    <link name="body">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.37" />
            <inertia
                ixx="0.0013545749333333335"
                ixy="0"
                ixz="0"
                iyy="0.0013545749333333335"
                iyz="0"
                izz="0.0013545749333333335"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="cube_gt.obj"/>
            </geometry>
            <material name="pennred">
                <color rgba="0.6 0 0 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="cube_gt.obj"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <drake:proximity_properties>
                <drake:mu_static value="0.15" />
            </drake:proximity_properties>
        </collision>
    </link>
</robot>