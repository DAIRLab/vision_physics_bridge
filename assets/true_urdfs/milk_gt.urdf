<!-- Computed inertial properties by assuming the mesh represents an infinitely
thin, uniformly dense, hollow object.  Done via cnets-data-generation's
test_mesh_inertia.py script, which generated the following, assuming a mass
value of 0.37 kg:

    Object:  milk
    Center of mass:  [0.00381566 0.00229598 0.04668316]
    Inertia tensor about center of mass:
        [[ 2.61359530e-03  4.36680415e-05 -4.64234145e-05]
        [ 4.36680415e-05  1.88433598e-03 -4.60274078e-04]
        [-4.64234145e-05 -4.60274078e-04  2.37777193e-03]]

TODO:  Need to pick a coefficient of friction based on measurements.
-->

<?xml version="1.0"?>
<robot name="object" xmlns:drake="https://drake.mit.edu/">
    <link name="body">
        <inertial>
            <origin xyz="0.00381566 0.00229598 0.04668316" rpy="0 0 0"/>
            <mass value="0.37" />
            <inertia
                ixx="2.61359530e-03"
                ixy="4.36680415e-05"
                ixz="-4.64234145e-05"
                iyy="1.88433598e-03"
                iyz="-4.60274078e-04"
                izz="2.37777193e-03" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="half_gt.obj"/>
            </geometry>
            <material name="pennred">
                <color rgba="0.6 0 0 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <mesh filename="half_gt.obj"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <drake:proximity_properties>
                <drake:mu_static value="0.15" />
            </drake:proximity_properties>
        </collision>
    </link>
</robot>